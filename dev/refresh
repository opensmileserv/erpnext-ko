#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f dev/compose.yml)
target=/home/frappe/frappe-bench/sites/assets/locale/ko/LC_MESSAGES/erpnext_ko.mo
./kotr compile --out work/erpnext_ko.mo
for service in backend queue scheduler; do
  "${compose[@]}" cp work/erpnext_ko.mo "$service:$target"
  "${compose[@]}" exec -T -u root "$service" chown frappe "$target"
done
"${compose[@]}" exec -T backend bench --site ko.localhost clear-cache
echo "ko.localhost 에 반영했다"
